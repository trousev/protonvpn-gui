# The application's name in the desktop's own menus — the `.desktop` entry's `Name=` key. A brand:
# the same words in every language, and the entry writes a key per language so a desktop can pick.
desktop-name = Proton VPN GUI

# The `.desktop` entry's `GenericName=` key: what kind of program this is, in two words. A menu
# may show it beside the name.
desktop-generic-name = VPN client

# The `.desktop` entry's `Comment=` key: one line under the name in a menu that has room for one.
# It says what the program actually is — a wrapper — in the same words the window uses.
desktop-comment = Console-first wrapper around the official protonvpn CLI
