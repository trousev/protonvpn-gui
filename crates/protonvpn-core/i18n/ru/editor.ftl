# Заголовок редактора соединения — модального окна поверх открытой страницы. Виджет сам рисует его
# заглавными, так что пишите обычным регистром. Это вариант для нового соединения; ширина окна
# 760px, и заголовок делит строку с кнопкой закрытия.
editor-title-new = Новое соединение

# Тот же заголовок, когда меняется уже сохранённое соединение. При переименовании соединение
# сохраняет свой id, так что это правка уже выбранного соединения.
editor-title-edit = Изменить соединение

# Строка под заголовком, 12pt и приглушённая. Списки стран и городов не наши: это то, что печатают
# `protonvpn countries list` и `protonvpn cities list`. Оба имени команд — данные, они не переводятся.
editor-subtitle = страна и город — из protonvpn countries list / cities list

# Подпись над полем названия соединения, 13pt. Само название — текст пользователя, не наш; это
# только подпись.
editor-name-label = Название соединения

# Плейсхолдер в пустом поле названия: пример того, как люди называют сохранённое соединение, а не
# подпись. Переводите пример так, чтобы он читался как правдоподобное название на целевом языке, а
# не как перевод английского.
editor-name-placeholder = например, Работа

# Плейсхолдер в поле поиска над списком стран. Фильтрует список, напечатанный CLI, по названию
# страны или по двухбуквенному коду. Не подпись: исчезает, как только начинают вводить.
editor-search-placeholder = Поиск страны или кода

# Первая строка списка стран: вариант, оставляющий страну невыбранной, чтобы подключение шло к
# быстрейшему серверу, а не к стране. Это настоящий выбор, нарисованный так же, как любая страна
# ниже, а не заполнитель. Подсказка под ним — editor-any-country-hint — говорит, что это значит для
# выполняемой команды.
editor-any-country = Любая страна

# Маленькая серая строка под editor-any-country. `--country` — собственный флаг CLI: не переводить и
# оставить точно как написано, вместе с дефисами.
editor-any-country-hint = без --country

# Заметка, занимающая место списка стран, пока `protonvpn countries list` не ответил. Команда
# выполняется один раз за запуск, так что это то, что панель показывает, пока команда ещё
# выполняется. Имя команды — данные, оно не переводится.
editor-countries-pending = Список стран ещё не прочитан: protonvpn countries list выполняется один раз за запуск.

# Заметка под ней, когда CLI отказался перечислять страны и ответил ошибкой. $message — собственный
# текст ошибки CLI, дословно, те самые байты, что он напечатал. Не переводить, не сокращать и не
# переформулировать; наши здесь только слова вокруг.
editor-country-error = CLI ответил ошибкой: { $message }

# Показывается в списке стран, когда поле поиска отсеяло все страны. Это утверждение о фильтре, а не
# о CLI: сам список может быть полным. Одна короткая тусклая строка.
editor-country-empty = Ничего не найдено.

# Заголовок правой панели, пока страна не выбрана. Виджет сам рисует его заглавными, так что пишите
# обычным регистром. Панель не может показать города для невыбранной страны.
editor-cities-title = Города

# Приглушённая строка под этим заголовком: почему панель пуста и что с этим делать. «города
# запрашиваются для конкретной» — это буквально: список городов CLI принимает страну.
editor-cities-pick-country = Сначала выберите страну — города запрашиваются для конкретной.

# Заголовок панели городов, когда страна выбрана. $country — название страны ровно так, как его
# напечатал CLI, — данные, они не переводятся; виджет рисует всю строку заглавными.
editor-cities-title-for = Города · { $country }

# Приглушённая строка в панели городов, пока список городов для выбранной страны ещё читается. Имени
# команды здесь нет: строка короткая, а консоль под окном и так показывает, что выполняется.
editor-cities-loading = Запрашиваю список городов…

# Первая строка списка городов: вариант, оставляющий город невыбранным, чтобы CLI выбрал быстрейший
# сервер в выбранной стране. Настоящий выбор, как editor-any-country.
editor-any-city = Любой город

# Маленькая серая строка под editor-any-city, объясняющая, что значит оставить город невыбранным.
editor-any-city-hint = быстрейший в стране

# Показывается в панели городов, когда в списке CLI для выбранной страны городов нет. Это не ошибка:
# в данных CLI у некоторых стран их просто нет.
editor-cities-empty = В этой стране нет городов в списке.

# Второстепенная кнопка внизу окна: закрыть редактор, ничего не меняя. Короткая, 13pt, в строке рядом
# с editor-save.
editor-cancel = Отмена

# Основная кнопка внизу окна: сохранить соединение. Короткая, 13pt. Она ничего не подтверждает о
# работе CLI — сохранение пишет профиль в наш собственный конфиг, и только.
editor-save = Сохранить
