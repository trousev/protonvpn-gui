# The heading of the language block, first on Settings → General. A user who has landed in a
# language they cannot read has to be able to find their way out without reading anything.
settings-language-title = Язык

# The line under the language heading. It explains what leaving the picker alone does, because
# "System" is not self-explanatory and the variables are the honest answer.
settings-language-hint = Следует за рабочим столом, пока вы не выберете здесь: переменные LANGUAGE, LC_ALL, LC_MESSAGES и LANG, по порядку, и английский, если ни одна из них не называет язык, который есть в этой сборке.

# The first entry of the language picker: use whatever the desktop asks for.
settings-language-system = Системный

## Сама страница.

# Мелкая строка над заголовком страницы, вверху «Настроек». Это имя самой страницы; виджет рисует
# его прописными, а не строка — пишите слово так, как его пишет заголовок.
settings-eyebrow = Настройки

# Заголовок страницы, 22px, в одной строке с кнопкой чтения. В каждой карточке ниже — ключи
# `protonvpn config list`; заголовок говорит, чьи это настройки. `CLI` — это та самая программа, и
# он остаётся как есть.
settings-heading = Параметры CLI

# Кнопка, которая ещё раз запускает `protonvpn config list`: в шапке страницы и ещё раз в пустом
# состоянии карточки CLI. `config list` — собственная подкоманда CLI, то есть командная строка; она
# не переводится.
settings-refresh = Прочитать config list

# Пустое состояние карточки CLI: ещё ничего не прочитано. Два коротких предложения, спокойных, а не
# тревожных — это первое, что видно на странице, и это не ошибка.
settings-unread = Настройки CLI ещё не прочитаны. Одна команда, около секунды — и здесь появится то, что CLI ответил.

# Описание ключа, который `protonvpn config list` напечатал, а приложение не описывает. Сам ключ
# показан рядом с этой строкой как есть — это данные.
settings-unknown-key = Ключ, которого нет в описании приложения: показан как есть.

# Серый placeholder в поле свободного значения. Встречается дважды: в карточке CLI для ключа без
# списка значений и на вкладке «Аккаунт», где отвечают на нераспознанный запрос. Одно слово.
settings-value-placeholder = значение

# Кнопка, которая записывает одно значение — `protonvpn config set` для настройки и то же слово для
# сохранения адреса, порта и интервала проверки прокси. Одно слово в узкой кнопке.
settings-apply = Применить

# Подпись списка своих DNS-серверов; стоит рядом с полем и только пока `custom-dns` включён. Сами
# серверы — адреса, они не переводятся.
settings-dns-servers = Серверы

## Слова для значений, которые печатает `protonvpn config list`. Само значение — данные (`off`,
## `malware-only`, `standard`) и не переводится; это наши слова о нём, чтобы никто не читал
## `malware-ads-trackers` в выпадающем списке.

# Значение `off` у NetShield, в списке на вкладке «Подключение». NetShield — собственное название
# продукта Proton, оставьте его точно как есть. Это намеренно не то же сообщение, что другие `off`:
# в языке с родом оно согласуется с NetShield, а не с безымянной настройкой.
settings-value-netshield-off = выключен

# Среднее значение NetShield: только вредоносные домены.
settings-value-netshield-malware-only = только вредоносные

# Самое сильное значение NetShield: вредоносные домены, реклама и трекеры вместе. Самый длинный
# пункт списка, а список шириной 240px.
settings-value-netshield-malware-ads-trackers = вредоносные, реклама и трекеры

# Значение `off` у kill switch. Отдельное сообщение по той же причине, что и у NetShield: оно
# согласуется со словами «kill switch». `Kill switch` — собственное название продукта Proton,
# оставьте его.
settings-value-kill-switch-off = выключен

# Включённое значение kill switch, которое CLI пишет как `standard`. Слово, а не значение CLI.
settings-value-kill-switch-standard = стандартный

# Общее `включено` в выпадающем списке — для настройки, которую эта страница никак не называет
# точнее. Средний род, в отличие от слов NetShield и kill switch выше.
settings-value-on = включено

# Общее `выключено` в выпадающем списке — для настройки, которую эта страница не называет точнее.
settings-value-off = выключено

## Наши собственные переключатели, на вкладках «Общие» и «Подключение».

# Заголовок блока с нашими переключателями. Он открывает вторую половину вкладки «Общие» и всю
# вкладку «Подключение» — одно слово, надзаголовок.
settings-app-section = Приложение

# Автозапуск. Подпись — одна короткая строка, описание идёт под ней приглушённым текстом.
settings-autostart-label = Автозапуск

# Что автозапуск делает на самом деле: держит один файл в соответствии с настройкой. Путь — данные,
# он не переводится.
settings-autostart-hint = Держать ~/.config/autostart/protonvpn-gui.desktop в соответствии с этой настройкой.

# Переключатель ярлыка .desktop: его подпись, одна короткая строка. Файл `.desktop` — формат файла,
# он остаётся как есть.
settings-desktop-entry-label = Ярлык в меню приложений

# Описание переключателя ярлыка .desktop — самое длинное на странице. Оно объясняет устройство, а не
# предпочтение: на Wayland у окна нет своей иконки. Не смягчайте это до «добавляет ярлык в меню» —
# именно от этой догадки оно и предостерегает.
settings-desktop-entry-hint = Установить .desktop и иконку в ~/.local/share. Это не украшение: на Wayland иконки у окна нет, и рабочий стол узнаёт имя и иконку только из .desktop — без него GNOME показывает окно как «Неизвестное приложение».

# Запуск свёрнутым в трей: подпись, одна короткая строка.
settings-start-minimized-label = Запускать свёрнутым в трей

# Что значит «свёрнутым»: окна нет вообще, пока не нажмут на трей.
settings-start-minimized-hint = Старт без окна: приложение сразу живёт в трее.

# Строка под переключателями: что сейчас лежит на диске и где хранятся наши собственные настройки.
# $autostart и $entry — слова из settings-yes и settings-no. Оба пути — данные, они не переводятся.
settings-files-line = Автозапуск: { $autostart } · ярлык: { $entry } · настройки приложения хранятся в ~/.config/protonvpn-gui/config.json. Файлы официального приложения мы не читаем и не пишем.

# Слово «есть на диске», используется только внутри settings-files-line. Одно слово.
settings-yes = есть

# Слово «нет на диске», используется только внутри settings-files-line.
settings-no = нет

# Подключение при запуске, на вкладке «Подключение»: подпись переключателя, одна короткая строка.
settings-connect-at-startup-label = Подключаться при запуске

# Описание этого переключателя. Оно несёт решение об устройстве: живой туннель не пересобирается,
# потому что `connect` по живому подключению молча меняет сервер. Сохраните это предложение — оно
# объясняет поведение переключателя.
settings-connect-at-startup-hint = Поднимает выбранное соединение сразу после старта — в том числе когда окна нет и приложение живёт в трее. Если CLI уже сообщает о подключении, туннель не трогаем: `connect` по живому подключению молча меняет сервер.

# Под этим переключателем: какое соединение возьмёт подключение при запуске и какую команду оно
# выполнит. $name — имя сохранённого соединения, как его ввёл человек, или имя пресета; это данные,
# они не переводятся. $argv — командная строка как есть, тоже данные.
settings-selected-connection = Сейчас выбрано: { $name } · $ { $argv }

## Карточка опроса, на вкладке «Опрос».

# Заголовок карточки: откуда приложение вообще узнаёт состояние.
settings-polling-eyebrow = Как мы узнаём состояние

# Первая строка карточки опроса. `protonvpn status` — командная строка, она не переводится; само
# предложение — честная причина, по которой опрос устроен именно так.
settings-polling-intro = protonvpn status стоит около секунды: каждый вызов запускает Python. Поэтому опрос устроен так:

# Первый из трёх пунктов: спокойный режим. Фрагмент, заканчивающийся точкой с запятой, — держите
# список однородным.
settings-polling-idle = спокойный режим — не чаще одного раза в 5 минут;

# Второй пункт: опрос сразу после команды, которая могла изменить туннель.
settings-polling-after-command = сразу после команды, которая могла изменить туннель;

# Третий пункт: опрос, когда на приложение смотрят.
settings-polling-when-you-look = когда вы смотрите — при открытии окна или клике по трею.

# Примечание в конце карточки. $age — уже готовый фрагмент на текущем языке («обновлено 3 минуты
# назад»), второй раз его переводить не нужно.
settings-polling-consequence = Следствие, которое мы не скрываем: состояние может быть старым. Рядом со статусом всегда стоит возраст: { $age }.

# Переключатель проверки через curl: подпись, одна короткая строка. `curl` — имя программы, оно
# остаётся как есть.
settings-probe-label = Проверять внешний адрес через curl

# Описание этого переключателя. Оно называет проверку исключением №1: единственный внешний вызов
# помимо protonvpn. `protonvpn` — имя программы, оно остаётся как есть.
settings-probe-hint = Исключение №1: единственный внешний вызов помимо protonvpn. Отвечает на вопрос, которого CLI не может — идёт ли трафик через туннель.

## Карточка аккаунта, на вкладке «Аккаунт».

# Заголовок карточки аккаунта.
settings-account-eyebrow = Аккаунт

# Показывается, когда `protonvpn info` назвал аккаунт. $name — имя, которое напечатал CLI; это
# данные, они не переводятся. Кнопка выхода стоит в другом конце той же строки.
settings-account-signed-in = Вы вошли как { $name }

# Кнопка выхода, рядом с именем аккаунта. Одно слово в узкой контурной кнопке.
settings-account-logout = Выйти

# Показывается, когда `protonvpn info` не назвал аккаунт. `protonvpn info` — командная строка, она
# остаётся как есть; обратные кавычки — буквальные символы.
settings-account-unconfirmed = Аккаунт не подтверждён: `protonvpn info` не назвал имя.

# Кнопка входа рядом с этим предложением. Одно слово.
settings-account-signin = Войти

# Объяснение под строкой аккаунта, показано и без входа. Это обещание про пароль и код 2FA, поэтому
# формулировка должна остаться точной.
settings-account-secret-hint = Пароль и код 2FA уходят прямо в PTY-терминал процесса CLI и никогда не попадают в консоль: она показывает только то, что напечатал CLI.

# Показывается, пока CLI ждёт ответа, который мы распознали. $prompt — слово из одного из трёх
# сообщений ниже.
settings-prompt-waiting = CLI ждёт ввода: { $prompt }

# Чего ждёт CLI, после двоеточия выше. Одно слово.
settings-prompt-password = пароль

# Одноразовый код из приложения-аутентификатора.
settings-prompt-two-factor = код 2FA

# Вопрос, который мы не смогли опознать. Это не ошибка: сам вопрос виден в консоли, и здесь
# сказано именно это.
settings-prompt-unrecognised = неопознанный запрос — смотрите консоль

# Серая строка на месте поля ручного ввода, когда вопроса нет. Она говорит, когда поле появится и
# где можно прочитать сам вопрос.
settings-account-manual-hint = Если CLI задаст вопрос, который мы не смогли распознать, поле появится здесь, а сам вопрос будет виден в консоли.

# Кнопка, отправляющая набранный ответ в PTY. Одно слово в узкой кнопке.
settings-send = Отправить

## Локальный SOCKS5-прокси — исключение №3 (docs/architecture.md §13).

# Заголовок карточки прокси. `SOCKS5` — имя протокола, оно не переводится.
settings-socks5-eyebrow = Приложение · SOCKS5

# Объяснение самой карточки. Это решение об устройстве, а не реклама: прокси отказывает всему,
# пока туннель не подтверждён, и по умолчанию он выключен. Сохраните оба факта.
settings-socks5-intro = Локальный SOCKS5-прокси для программ, которые должны ходить в сеть только через VPN: приложение настраивается на этот адрес, а прокси отказывает всему, пока не подтверждено, что трафик идёт через туннель. Выключено по умолчанию.

# Флажок, включающий прокси.
settings-socks5-enable = Включить локальный SOCKS5-прокси

# Подпись поля адреса, стоит рядом с ним. Одно слово. Адрес в поле — петлевой адрес, это данные.
settings-socks5-address-label = Адрес

# Подпись поля порта. Одно слово.
settings-socks5-port-label = Порт

# Подпись поля с интервалом проверки туннеля в секундах. Узкая: стоит между полем порта и кнопкой
# «Применить», поэтому держите её короткой. `0` в поле выключает внешнюю проверку.
settings-socks5-verify-label = Проверка туннеля, с

# Строка состояния, когда шлюз открыт. $source — локальный IPv4-адрес, которым ядро отвечает на
# вопрос о маршруте; это данные, они не переводятся.
settings-socks5-open = открыт · маршрут подтверждён: { $source }

# Строка состояния, когда шлюз закрыт. $reason — готовое предложение из каталога (`proxy-gate-*`:
# «VPN не подключён», «маршрут 10.0.0.2 не подтверждён…»), уже на языке читателя: не переводите его
# второй раз и сохраните разделитель.
settings-socks5-closed = закрыт · { $reason }

# Совет под строкой состояния, когда прокси включён, но CLI не сообщает о подключении: ничего не
# сломано, шлюз откроется сам. Одно предложение.
settings-socks5-advice-not-connected = Прокси откроется сам, как только CLI сообщит о подключении.

# Совет, когда маршрут ядра не наблюдался до подключения и сравнивать его не с чем. Два имени кнопок
# в нём — «Отключить», затем «Подключиться» — это слова страницы «Обзор»; переведите их так же.
settings-socks5-advice-unverified = Приложение не видело, каким маршрут был до подключения, и не может утверждать, что нынешний — туннель. Переподключитесь (Отключить, затем Подключиться): тогда маршрут подтвердится.

# Совет, когда подтверждённый маршрут изменился или исчез. Прямо, без паники: это прокси делает свою
# работу и не пропустит ни байта, пока туннель не подтвердится заново.
settings-socks5-advice-route = Переподключитесь, чтобы подтвердить туннель заново: пока это не сделано, прокси не выпустит ни байта.

# Совет, когда проверка внешнего адреса снова видит адрес до подключения: туннель не несёт трафик,
# что бы ни говорил CLI.
settings-socks5-advice-egress = Проверка внешнего адреса увидела тот же адрес, что и до подключения. Переподключитесь.

# Совет, когда фоновая проверка туннеля перестала отвечать. Он говорит ровно то, что осталось —
# локальная проверка маршрута, — и чего эта проверка не видит.
settings-socks5-advice-probe-silent = Внешняя проверка туннеля не отвечает: без неё остаётся только локальная проверка маршрута, а она видит не всё. Проверьте связь и переподключитесь, чтобы туннель подтвердился заново.

# Совет, когда слушателя нет: адрес не петлевой или порт занят. `localhost` — имя хоста, оно
# остаётся как есть.
settings-socks5-advice-not-listening = Проверьте адрес и порт: слушать можно только localhost.

# Кнопка, копирующая адрес прокси в буфер обмена. Узкая, контурная.
settings-socks5-copy = Копировать адрес

# Подтверждение на две секунды после копирования. $address — скопированный адрес, это данные, они не
# переводятся.
settings-socks5-copied = { $address } скопирован

# Серая строка, говорящая, на что настраивать свою программу. $address — адрес и порт слушателя,
# это данные. `SOCKS5` — имя протокола.
settings-socks5-point-at = Настройте приложение на { $address } (SOCKS5, без аутентификации).

# Строка счётчиков под кнопкой копирования. Все числа — счётчики прокси, а два объёма байт приходят
# уже написанными на этом языке из human_bytes («4.9 МиБ»). Числа, единицы и косая черта — данные;
# пять слов вокруг них — наши.
settings-socks5-counters = принято { $accepted } · отказано { $refused } · активно { $active } · передано { $up } / { $down }

# Дописывается к строке счётчиков, когда соединения отвергли из-за предела сессий. $overloaded —
# это число, чтобы язык с тремя формами множественного числа мог согласовать слово после него.
# Начинается с разделителя, который присоединяет его к строке выше.
settings-socks5-overloaded = { $overloaded ->
        [one] · нет места ещё для { $overloaded } сессии
        [few] · нет места ещё для { $overloaded } сессий
       [many] · нет места ещё для { $overloaded } сессий
       *[other] · нет места ещё для { $overloaded } сессий
    }

# Серая строка, показанная когда проверка через curl выключена: она называет ровно то, что
# потеряно, и то, что осталось. `curl` — имя программы; «вкладка Опрос» — собственная вкладка этой
# страницы.
settings-socks5-probe-off = Внешняя проверка туннеля выключена вместе с проверкой внешнего адреса на вкладке «Опрос»: остаётся только локальная проверка маршрута, каждые 200 мс.

# Серая строка о том, что прокси не пропускает. `localhost`, `IPv4`, `CONNECT` и `ssh -D` — факты о
# протоколе и о сравнении, они не переводятся.
settings-socks5-loopback = Только localhost и только IPv4; из команд SOCKS5 — только CONNECT. Аутентификации нет: порт слушает петлевой интерфейс, ровно как у `ssh -D`.

# Последняя серая строка: как читается маршрут и что делает поле секунд. `curl` — имя программы,
# `200 мс` — измерение, `0` — значение поля.
settings-socks5-watchdog = Маршрут ядра перечитывается каждые 200 мс — без пакетов и без третьих сторон. Раз в указанное число секунд туннель подтверждается внешним адресом той же проверкой curl, что и на «Обзоре»; 0 выключает её, локальная проверка остаётся.

## Обновление AppImage — исключение №4 (docs/architecture.md §14).

# Четыре политики обновления, нарисованы рядом радиокнопками в этом порядке: от «не трогайте меня»
# до «делай всё». Их четыре в одной строке, поэтому держите их короткими.
settings-update-policy-off = не проверять

# Сообщить о новом релизе и больше ничего не делать.
settings-update-policy-notify = только сообщать

# Скачать и проверить, но не подменять файл.
settings-update-policy-download = скачивать

# Скачать и подменить; заработает при следующем запуске.
settings-update-policy-install = скачивать и ставить

# Заголовок карточки обновления, первой на вкладке «Общие». `AppImage` — формат пакета, он остаётся
# как есть.
settings-updates-eyebrow = Приложение · Обновления

# Объяснение карточки. Оно несёт решение об устройстве: скачанное никогда не запускается само, а
# предыдущий образ остаётся рядом как <имя>.old на один запуск. Сохраните оба факта; не смягчайте их
# до «приложение обновляет себя».
settings-updates-intro = AppImage не обновляет никто, кроме него самого: приложение спрашивает свою страницу релизов, сверяет скачанное с SHA256SUMS из того же релиза и подменяет файл на месте. Скачанное никогда не запускается само — новая версия заработает при следующем запуске, а предыдущая остаётся рядом как <имя>.old на один запуск.

# Строка о том, какая это сборка. $version — номер версии или предложение из
# chrome-version-unversioned; и то и другое данные, они не переводятся. К строке дописывается одно
# из двух сообщений ниже, через разделитель « · ».
settings-updates-version = Версия: { $version }

# Дописывается к строке версии: когда страницу релизов спрашивали в последний раз. $age — готовый
# фрагмент из таблицы возраста («обновлено 3 минуты назад»), второй раз его переводить не нужно.
settings-updates-page-age = страница релизов: { $age }

# Дописывается к строке версии, когда страницу релизов ещё ни разу не спрашивали.
settings-updates-page-never = страницу релизов ещё не спрашивали

# Кнопка, которая спрашивает страницу релизов прямо сейчас. Она недоступна, пока идёт проверка или
# скачивание.
settings-updates-check-now = Проверить сейчас

# Кнопка, останавливающая идущее скачивание. Одно слово.
settings-updates-cancel = Отменить

# Кнопка, которая ставит уже скачанный и проверенный образ на место.
settings-updates-install = Установить

# Кнопка, которая скачивает новый релиз и ставит его на место. Длиннее предыдущей; вместе они не
# показываются.
settings-updates-download-install = Скачать и установить

# Кнопка, которая перестаёт упоминать обновление для этой версии. Маленькая и тихая, в том же ряду.
settings-updates-dismiss = Не напоминать

# Серая строка под кнопками: когда идёт автоматическая проверка и что политика делает, а что нет.
# Утверждение, что запущенный процесс не трогают, — здесь самое важное, сохраните его.
settings-updates-footnote = Проверка — раз в сутки и через десять секунд после запуска; политика решает, что приложение делает само, а кнопки работают всегда. Новая версия начинает работать после перезапуска: подмена не трогает уже запущенный процесс.

# Примечание, показанное когда последняя проверка или скачивание не удались. $error — собственное
# сообщение обновлятеля, это данные, они не переводятся.
settings-updates-error = Последняя попытка не удалась: { $error }

# Примечание, показанное когда эта сборка не может подменить себя: установка из tar или `cargo run`.
# Оно говорит, что делать вместо этого.
settings-updates-not-replaceable = Эта сборка не AppImage (или запущена не из образа): подменить себя она не может. Обновление придётся скачать со страницы релизов вручную.

# Последняя серая строка: что контрольная сумма доказывает, а что нет. Честность здесь намеренная —
# сумма не доказывает авторство. `SHA256SUMS`, `GitHub`, `gh attestation verify` и `SECURITY.md` —
# имена, они не переводятся.
settings-updates-sums = SHA256SUMS закрывает обрыв, порчу и зеркало, отдающее вчерашний образ, но не подмену на стороне GitHub: подлинность проверяется отдельно, `gh attestation verify` — SECURITY.md.

# Строка состояния обновлятеля: по одному сообщению на состояние. Две ошибки, которые обычно делают
# такие строки, здесь названы прямо: «скачано» — это не «установлено», а «установлено» — не
# «работает».

# Страницу релизов спрашивают прямо сейчас. Коротко, с многоточием в конце.
settings-update-checking = спрашиваем страницу релизов…

# Идёт скачивание, размер известен. $received и $total приходят уже написанными на этом языке из
# human_bytes («4.9 МиБ»), это данные.
settings-update-downloading = качаем { $received } из { $total }

# То же самое, пока релиз не сказал размер образа.
settings-update-downloading-unknown = качаем { $received }

# Образ скачан, сверен с SHA256SUMS и ждёт перезапуска. $version — номер версии, это данные, они не
# переводятся.
settings-update-staged = { $version } скачана и проверена — ждёт перезапуска

# Образ уже на месте и заработает при следующем запуске. $version — номер версии.
settings-update-installed = { $version } на месте — заработает после перезапуска

# Страницу релизов ещё ни разу не спрашивали.
settings-update-never-checked = ещё не проверяли

# Страница релизов ответила, и в последнем релизе нет образа, который можно поставить. Намеренно не
# то же самое, что «ещё не проверяли».
settings-update-no-image = в последнем релизе нет образа, который я мог бы поставить

# Есть более новый релиз. $latest — номер версии, это данные, они не переводятся.
settings-update-available = доступна { $latest }

# Эта сборка новее последнего релиза — так выглядит сборка для разработки.
settings-update-ahead = { $current } — новее последнего релиза ({ $latest })

# Эта сборка и есть последний известный релиз. $current — номер версии.
settings-update-current = { $current } — последняя версия

# Сборка без собственной версии в сравнении с последним релизом. $latest — номер версии.
settings-update-versionless = последний релиз: { $latest }; эта сборка без версии

## То, как `protonvpn config list` называет свои ключи, словами для человека: одно имя и одно
## описание на ключ. Сам ключ — `netshield`, `kill-switch` — это данные, он остаётся как есть рядом
## с именем. Собственные названия продуктов Proton (NetShield, Kill switch, VPN Accelerator,
## Moderate NAT, IPv6) одинаковы во всех языках, и там, где они встречаются, это отмечено.

# NetShield. Собственное название продукта Proton — оставьте его точно как есть в любом языке.
settings-name-netshield = NetShield

# Что делает NetShield, под его именем на вкладке «Подключение».
settings-hint-netshield = Блокировать вредоносные домены на уровне DNS шлюза.

# Kill switch. Собственное название продукта Proton — оставьте его как есть.
settings-name-kill-switch = Kill switch

# Что делает kill switch. Коротко: одна строка под именем.
settings-hint-kill-switch = Блокировать трафик, если туннель падает.

# Порт-форвардинг. Описание говорит, кто держит аренду, потому что это наше собственное поведение:
# порт выдаёт CLI, а сопоставление продлеваем мы. `NAT-PMP` — имя протокола, оно остаётся.
settings-name-port-forwarding = Порт-форвардинг

# Что делает порт-форвардинг и кто продлевает аренду.
settings-hint-port-forwarding = Разрешить серверу выдавать проброшенный порт. Аренду держим мы, через NAT-PMP.

# Свои DNS-серверы.
settings-name-custom-dns = Свои DNS

# Что делают свои DNS. Сами серверы — адреса, они не переводятся.
settings-hint-custom-dns = Использовать указанные DNS-серверы внутри туннеля.

# VPN Accelerator. Собственное название продукта Proton — оставьте его как есть.
settings-name-vpn-accelerator = VPN Accelerator

# Что делает VPN Accelerator. Одна короткая строка.
settings-hint-vpn-accelerator = Ускорение на дальних серверах.

# Moderate NAT. Собственное название продукта Proton — оставьте его как есть.
settings-name-moderate-nat = Moderate NAT

# Что делает Moderate NAT. `P2P` — собственное название Proton для таких серверов, оно остаётся.
settings-hint-moderate-nat = Мягкий NAT для игр и P2P.

# IPv6. Имя протокола, одинаковое во всех языках. Настройка пропускает IPv6 внутри туннеля.
settings-name-ipv6 = IPv6

# Что делает настройка IPv6.
settings-hint-ipv6 = Пропускать IPv6 внутри туннеля.

# Анонимные отчёты о сбоях.
settings-name-anonymous-crash-reports = Анонимные отчёты о сбоях

# Что делает эта настройка: краш-логи отправляются, но не привязываются к аккаунту.
settings-hint-anonymous-crash-reports = Отправлять краш-логи без привязки к аккаунту.
